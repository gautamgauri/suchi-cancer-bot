---
/**
 * Link to the web chat on the hospital and place pages. The heading and the
 * button text are the ones the Hospital Directory page already uses.
 */
export interface Props {
  /** From chatUrlFor(), so the link carries the page's src code. */
  href: string;
}
const { href } = Astro.props;
---

<aside class="hc-cta">
  <p class="hc-heading">Not sure which hospital is right for you?</p>
  <a href={href} target="_blank" rel="noopener" class="hc-btn">Ask Suchi →</a>
</aside>

<style>
  .hc-cta {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    padding: 1.5rem 1.25rem;
    text-align: center;
  }
  .hc-heading {
    font-family: var(--font-serif);
    font-size: var(--text-xl, 1.25rem);
    color: var(--color-text-dark);
    margin: 0 0 1rem;
  }
  .hc-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.5rem;
    background: var(--color-accent);
    color: #1f2937;
    border-radius: var(--radius-md, 8px);
    font-weight: 600;
    text-decoration: none;
  }
  .hc-btn:hover { background: var(--color-accent-hover); }
</style>
