---
/**
 * Links from the Hospital Directory to the city and state pages, grouped by
 * state. Server-rendered list, no script.
 */
import hospitalsData from '../content/hospitals.json';
import { hospitalSite } from '../lib/hospital-pages.mjs';

const { places, stateOf } = hospitalSite(hospitalsData);
const byState = new Map<string, typeof places>();
for (const p of places) byState.set(p.state, [...(byState.get(p.state) ?? []), p]);
const groups = [...byState.entries()].sort((a, b) => a[0].localeCompare(b[0], 'en'));
---

<nav class="hpl" aria-labelledby="hpl-heading">
  <h2 id="hpl-heading" class="hpl-heading">Hospitals by city</h2>
  <ul class="hpl-states">
    {groups.map(([state, ps]) => {
      const sp = stateOf.get(state);
      return (
        <li>
          {sp ? <a class="hpl-state" href={sp.path}>{state}</a> : <span class="hpl-state">{state}</span>}
          <ul class="hpl-places">
            {ps.map((p) => (
              <li><a href={p.path}>{p.place}</a></li>
            ))}
          </ul>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .hpl { margin: 0 0 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .hpl-heading { font-family: var(--font-serif); font-size: var(--text-2xl, 1.5rem); color: var(--color-text-dark); margin: 0 0 1rem; }
  .hpl-states { list-style: none; padding: 0; margin: 0; columns: 3 15rem; column-gap: 2rem; }
  .hpl-states > li { break-inside: avoid; margin-bottom: 1rem; }
  .hpl-state { font-weight: 700; color: var(--color-text-dark); }
  a.hpl-state { color: var(--color-primary); }
  .hpl-places { list-style: none; padding: 0; margin: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0 1rem; }
  .hpl a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-primary); }
</style>
