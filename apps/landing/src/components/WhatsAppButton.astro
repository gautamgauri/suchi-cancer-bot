---
/**
 * "Ask on WhatsApp" link to Suchi's public WhatsApp number, with a greeting
 * already typed (see src/lib/whatsapp-link.mjs).
 *
 *   variant="nav"     pill in the header bar. Icon only below 1280 px.
 *   variant="menu"    full-width item in the mobile menu.
 *   variant="button"  in-page button. Put it in a `.wa-cta-row` beside the
 *                     web chat link, so the two wrap cleanly on a phone.
 */
import { whatsappUrl } from '../lib/whatsapp-link.mjs';

export interface Props {
  source: 'wa-header' | 'wa-article' | 'wa-video' | 'wa-hospitals';
  variant?: 'nav' | 'menu' | 'button';
}

const { source, variant = 'button' } = Astro.props;
const href = whatsappUrl(source);
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class={`wa-link wa-link--${variant}`}
  data-wa-source={source}
>
  <svg class="wa-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
  </svg>
  {variant === 'nav' ? (
    <span class="wa-label"><span class="wa-label-lead">Ask on </span>WhatsApp</span>
  ) : (
    <span class="wa-label">Ask on WhatsApp</span>
  )}
</a>

<style>
  .wa-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .wa-icon {
    flex-shrink: 0;
  }

  /* In-page button, on light backgrounds. */
  .wa-link--button {
    min-height: 44px;
    padding: 0.5rem 1.125rem;
    background: #fff;
    color: #075e54;
    border: 2px solid #25d366;
    border-radius: var(--radius-md);
    font-size: 0.9375rem;
    line-height: 1.2;
    transition: background var(--transition-fast);
  }
  .wa-link--button .wa-icon {
    color: #128c7e;
  }
  .wa-link--button:hover {
    background: #e9fbf0;
    color: #075e54;
  }
  .wa-link--button:focus-visible {
    outline: 3px solid #075e54;
    outline-offset: 2px;
  }

  /* Header pill, on the dark bar. Matches .nav-cta. */
  .wa-link--nav {
    display: none;
    height: 34px;
    min-width: 34px;
    padding: 0 0.5rem;
    border-radius: var(--radius-full);
    background: rgba(246, 250, 255, 0.04);
    color: #25d366;
    border: 1px solid rgba(37, 211, 102, 0.45);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition: all var(--transition-fast);
  }
  /* 34 px to look like its neighbour, 44 px to touch. */
  .wa-link--nav::after {
    content: '';
    position: absolute;
    inset: -5px;
  }
  .wa-link--nav:hover {
    background: rgba(37, 211, 102, 0.12);
    border-color: rgba(37, 211, 102, 0.7);
    color: #25d366;
    transform: translateY(-1px);
  }
  .wa-link--nav:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .wa-link--nav .wa-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .wa-link--nav .wa-label-lead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .wa-link--nav {
      display: inline-flex;
    }
  }
  @media (min-width: 1280px) {
    .wa-link--nav {
      padding: 0 1rem 0 0.75rem;
    }
    .wa-link--nav .wa-label {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }

  /* Mobile menu item, under "Ask Suchi". The menu sets padding and display on links. */
  .wa-link--menu {
    display: flex;
    min-height: 44px;
    text-align: center;
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
    border: 1px solid rgba(37, 211, 102, 0.35);
  }
  .wa-link--menu:hover {
    background: rgba(37, 211, 102, 0.16);
  }
  .wa-link--menu:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
