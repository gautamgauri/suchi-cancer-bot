---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const URL_SEGMENT = 'cancer-types';

const all = await getCollection('articles');
const articles = all
  .filter((a) => a.data.content_type === 'cancer_type')
  .filter((a) => !a.data.hide_from_index)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const DISPLAY_NAME: Record<string, string> = {
  'breast-cancer':     'Breast Cancer',
  'cervical-cancer':   'Cervical Cancer',
  'colorectal-cancer': 'Colorectal Cancer',
  'leukemia':          'Leukemia',
  'lung-cancer':       'Lung Cancer',
  'lymphoma':          'Lymphoma',
  'oral-cancer':       'Oral Cancer',
  'ovarian-cancer':    'Ovarian Cancer',
  'pediatric-cancers': 'Childhood Cancer',
  'prostate-cancer':   'Prostate Cancer',
};

const SHORT_NAME: Record<string, string> = {
  'breast-cancer':     'Breast',
  'cervical-cancer':   'Cervical',
  'colorectal-cancer': 'Colorectal',
  'leukemia':          'Leukemia',
  'lung-cancer':       'Lung',
  'lymphoma':          'Lymphoma',
  'oral-cancer':       'Oral',
  'ovarian-cancer':    'Ovarian',
  'pediatric-cancers': 'Pediatric',
  'prostate-cancer':   'Prostate',
};

type CancerMeta = { keyFact: string; svg: string };

const CANCER_META: Record<string, CancerMeta> = {
  'breast-cancer': {
    keyFact: 'Most common cancer in Indian women — early detection saves lives',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 36 C6 24 14 12 24 12 C34 12 42 24 42 36"/>
      <line x1="4" y1="36" x2="44" y2="36"/>
      <circle cx="24" cy="26" r="2.5" fill="currentColor" stroke="none"/>
    </svg>`,
  },
  'cervical-cancer': {
    keyFact: 'Entirely preventable with HPV vaccination and regular screening',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M24 39 C17 39 11 34 11 27 C11 20 16 16 22 14 L22 9 L26 9 L26 14 C32 16 37 20 37 27 C37 34 31 39 24 39"/>
      <path d="M22 14 Q15 11 9 13"/>
      <path d="M26 14 Q33 11 39 13"/>
      <line x1="24" y1="39" x2="24" y2="44"/>
    </svg>`,
  },
  'colorectal-cancer': {
    keyFact: 'Often grows silently — colonoscopy screening can find it early',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M32 40 C38 40 42 36 42 28 C42 20 38 14 32 12"/>
      <path d="M16 12 C10 14 6 20 6 28 C6 36 10 40 16 40"/>
      <path d="M16 12 C18 8 22 6 24 6 C26 6 30 8 32 12"/>
      <line x1="16" y1="40" x2="16" y2="45"/>
      <line x1="32" y1="40" x2="32" y2="45"/>
    </svg>`,
  },
  'leukemia': {
    keyFact: 'A family of blood cancers affecting children and adults alike',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M24 6 C22 10 10 22 10 30 C10 37.5 16.5 43 24 43 C31.5 43 38 37.5 38 30 C38 22 26 10 24 6"/>
      <circle cx="19" cy="33" r="2.5"/>
      <circle cx="27" cy="29" r="2.5"/>
      <circle cx="25" cy="37" r="2"/>
    </svg>`,
  },
  'lung-cancer': {
    keyFact: 'Leading cancer killer globally — smoking is the primary risk factor',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="24" y1="8" x2="24" y2="17"/>
      <path d="M24 14 C22 14 20 15 20 17"/>
      <path d="M24 14 C26 14 28 15 28 17"/>
      <path d="M20 17 C14 19 10 25 10 32 C10 38 13 42 18 42 C21 42 23 39 23 36 L23 19"/>
      <path d="M28 17 C34 19 38 25 38 32 C38 38 35 42 30 42 C27 42 25 39 25 36 L25 19"/>
    </svg>`,
  },
  'lymphoma': {
    keyFact: 'Cancer of the lymph system — often highly treatable with chemotherapy',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="24" cy="11" r="5"/>
      <circle cx="13" cy="25" r="5"/>
      <circle cx="35" cy="25" r="5"/>
      <circle cx="17" cy="39" r="4"/>
      <circle cx="31" cy="39" r="4"/>
      <line x1="20" y1="15" x2="16" y2="21"/>
      <line x1="28" y1="15" x2="32" y2="21"/>
      <line x1="14" y1="30" x2="16" y2="35"/>
      <line x1="34" y1="30" x2="32" y2="35"/>
    </svg>`,
  },
  'oral-cancer': {
    keyFact: 'India has one of the highest rates globally — tobacco is the main cause',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M10 22 Q18 15 24 15 Q30 15 38 22 Q30 33 24 33 Q18 33 10 22Z"/>
      <path d="M10 22 Q24 27 38 22"/>
      <line x1="17" y1="17" x2="17" y2="26"/>
      <line x1="22" y1="16" x2="22" y2="27"/>
      <line x1="26" y1="16" x2="26" y2="27"/>
      <line x1="31" y1="17" x2="31" y2="26"/>
    </svg>`,
  },
  'ovarian-cancer': {
    keyFact: 'Subtle early signs — persistent bloating or pelvic pain deserve investigation',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <ellipse cx="24" cy="30" rx="6" ry="8"/>
      <ellipse cx="11" cy="21" rx="6" ry="5"/>
      <ellipse cx="37" cy="21" rx="6" ry="5"/>
      <path d="M17 22 C18 24 20 27 20 30"/>
      <path d="M31 22 C30 24 28 27 28 30"/>
    </svg>`,
  },
  'pediatric-cancers': {
    keyFact: 'Childhood cancers are among the most treatable — early diagnosis is crucial',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="24" cy="11" r="6"/>
      <path d="M18 19 L18 30 L30 30 L30 19 Z"/>
      <line x1="18" y1="30" x2="16" y2="42"/>
      <line x1="30" y1="30" x2="32" y2="42"/>
      <line x1="18" y1="22" x2="9" y2="27"/>
      <line x1="30" y1="22" x2="39" y2="27"/>
    </svg>`,
  },
  'prostate-cancer': {
    keyFact: 'Common in men over 50 — PSA screening can detect it while still treatable',
    svg: `<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M24 14 C15 14 10 20 10 27 C10 34 16 40 24 40 C32 40 38 34 38 27 C38 20 33 14 24 14"/>
      <path d="M17 14 C17 10 20 8 24 8 C28 8 31 10 31 14"/>
      <line x1="24" y1="40" x2="24" y2="45"/>
      <line x1="24" y1="16" x2="24" y2="38"/>
    </svg>`,
  },
};

const pageTitle = 'Cancer Types';
const pageDescription =
  'Read about specific cancer types — what they are, common warning signs, how they are diagnosed, and treatment basics.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hub-page">
    <div class="hub-inner">

      <header class="hub-header">
        <p class="hub-eyebrow">Knowledge Hub</p>
        <h1>{pageTitle}</h1>
        <p class="hub-intro">
          Read about specific cancer types — what they are, common warning signs, how they are
          diagnosed, and treatment basics. All content is reviewed against trusted medical sources.
        </p>
      </header>

      <nav class="filter-bar" aria-label="Browse by cancer type">
        <button class="pill pill--active" data-filter="all">All types</button>
        {articles.map((a) => (
          <button class="pill" data-filter={a.data.page_id}>
            {SHORT_NAME[a.data.page_id] ?? a.data.title.split(':')[0].trim()}
          </button>
        ))}
      </nav>

      {articles.length === 0 ? (
        <div class="hub-empty">
          <p>Articles in this section are coming soon.</p>
        </div>
      ) : (
        <ul class="card-grid" id="card-grid" role="list">
          {articles.map((a) => {
            const meta: CancerMeta = CANCER_META[a.data.page_id] ?? { keyFact: '', svg: '' };
            const displayName = DISPLAY_NAME[a.data.page_id] ?? a.data.title.split(':')[0].trim();
            return (
              <li class="card-item" data-type={a.data.page_id}>
                <a href={`/${URL_SEGMENT}/${a.data.page_id}/`} class="card">
                  <div class="card-icon-wrap">
                    <div class="card-icon" set:html={meta.svg} />
                  </div>
                  <div class="card-body">
                    <h2 class="card-title">{displayName}</h2>
                    {meta.keyFact && <p class="card-fact">{meta.keyFact}</p>}
                    <div class="card-tags" aria-label="Topics covered">
                      <span class="tag">Symptoms</span>
                      <span class="tag">Diagnosis</span>
                      <span class="tag">Treatment</span>
                    </div>
                  </div>
                  <footer class="card-footer">
                    <time
                      class="card-meta"
                      datetime={new Date(a.data.last_reviewed).toISOString()}
                    >
                      Reviewed{' '}
                      {new Date(a.data.last_reviewed).toLocaleDateString('en-IN', {
                        year: 'numeric',
                        month: 'short',
                      })}
                    </time>
                    <span class="card-cta" aria-hidden="true">Read guide →</span>
                  </footer>
                </a>
              </li>
            );
          })}
        </ul>
      )}

      <aside class="support-box">
        <div class="support-box-body">
          <h2 class="support-title">Not sure where to start?</h2>
          <p class="support-desc">
            If you are not sure which cancer type to look up, start by exploring symptoms,
            find a specialist near you, or ask Suchi directly.
          </p>
          <div class="support-links">
            <a href="/symptoms/" class="support-link">Browse symptoms</a>
            <a href="/find-care/" class="support-link">Find care near you</a>
            <a href="/#ask" class="support-link">Ask Suchi</a>
          </div>
        </div>
      </aside>

    </div>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
  const items = document.querySelectorAll<HTMLLIElement>('.card-item');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter ?? 'all';

      pills.forEach((p) => {
        p.classList.remove('pill--active');
        p.setAttribute('aria-pressed', 'false');
      });
      pill.classList.add('pill--active');
      pill.setAttribute('aria-pressed', 'true');

      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.type === filter;
        (item as HTMLElement).hidden = !show;
      });
    });
  });
</script>

<style>
  .hub-page {
    padding: 3rem 1rem 5rem;
    background: var(--color-bg);
  }

  .hub-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  /* ── Header ─────────────────────────────────────── */
  .hub-header {
    margin-bottom: 2rem;
  }

  .hub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-warm);
    margin: 0 0 0.5rem;
  }

  .hub-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    line-height: 1.2;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }

  .hub-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 62ch;
    margin: 0;
  }

  /* ── Filter pills ───────────────────────────────── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: white;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color var(--transition-fast),
                background var(--transition-fast),
                color var(--transition-fast);
    white-space: nowrap;
  }

  .pill:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .pill--active {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: white;
  }

  .pill--active:hover {
    color: white;
  }

  /* ── Card grid ──────────────────────────────────── */
  .card-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .card-item {
    margin: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
  }

  .card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  /* ── Card icon ──────────────────────────────────── */
  .card-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-accent-soft, #fdf3e3);
    color: var(--color-text-warm, #b45309);
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .card-icon svg {
    width: 32px;
    height: 32px;
  }

  /* ── Card body ──────────────────────────────────── */
  .card-body {
    flex: 1;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-dark);
    margin: 0 0 0.375rem;
    line-height: 1.3;
  }

  .card-fact {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 1rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: var(--color-bg-soft, #f8f5f0);
    color: var(--color-text-muted);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* ── Card footer ────────────────────────────────── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .card-meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .card-cta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }

  /* ── Empty state ────────────────────────────────── */
  .hub-empty {
    background: var(--color-bg-soft);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .hub-empty p {
    margin: 0;
    max-width: none;
  }

  /* ── Support box ────────────────────────────────── */
  .support-box {
    background: var(--color-bg-soft, #f8f5f0);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem 2.5rem;
  }

  .support-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
    margin: 0 0 0.5rem;
  }

  .support-desc {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
    max-width: 56ch;
  }

  .support-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .support-link {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.125rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .support-link:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ── Responsive ─────────────────────────────────── */
  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    .hub-header h1 {
      font-size: var(--text-4xl);
    }

    .card-grid {
      grid-template-columns: 1fr;
    }

    .filter-bar {
      gap: 0.375rem;
    }

    .pill {
      font-size: 0.8125rem;
      padding: 0.3125rem 0.75rem;
    }

    .support-box {
      padding: 1.5rem;
    }
  }
</style>
