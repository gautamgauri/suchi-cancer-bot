---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const URL_SEGMENT = 'find-care';

const all = await getCollection('articles');
const articles = all
  .filter((a) => a.data.content_type === 'find_care')
  .filter((a) => !a.data.hide_from_index)
  .sort((a, b) => {
    const da = new Date(a.data.last_reviewed).getTime();
    const db = new Date(b.data.last_reviewed).getTime();
    if (db !== da) return db - da;
    return a.data.title.localeCompare(b.data.title);
  });

const pageTitle = 'Find Care';
const pageDescription =
  'Locate cancer care services in India — hospitals, screening centres, government schemes, and helplines that can help you take the next step.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="hub-page">
    <div class="hub-inner">
      <header class="hub-header">
        <p class="hub-eyebrow">Knowledge Hub</p>
        <h1>{pageTitle}</h1>
        <p class="hub-intro">
          Locate cancer care services in India — hospitals, screening centres, government schemes,
          and helplines that can help you take the next step. All content is reviewed against
          trusted medical sources.
        </p>
      </header>

      <a href="/find-care/hospitals/" class="hosp-dir-card">
        <div class="hosp-dir-icon" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="14" width="28" height="22" rx="2"/>
            <path d="M14 36V26h12v10"/>
            <path d="M6 18l14-12 14 12"/>
            <line x1="20" y1="20" x2="20" y2="24"/>
            <line x1="18" y1="22" x2="22" y2="22"/>
          </svg>
        </div>
        <div class="hosp-dir-body">
          <p class="hosp-dir-eyebrow">New</p>
          <h2 class="hosp-dir-title">Hospital Directory</h2>
          <p class="hosp-dir-desc">
            47 verified cancer hospitals across East India and national referral centres — Delhi,
            Mumbai, Bangalore, Chennai, Vellore, Chandigarh, and more — with departments, cost,
            PMJAY status, and contact details.
          </p>
        </div>
        <span class="hosp-dir-arrow">→</span>
      </a>

      {articles.length === 0 ? (
        <div class="hub-empty">
          <p>Articles in this section are coming soon.</p>
        </div>
      ) : (
        <ul class="hub-list">
          {articles.map((a) => (
            <li class="hub-item">
              <a href={`/${URL_SEGMENT}/${a.data.page_id}/`} class="hub-card">
                <div class="hub-card-head">
                  <h2 class="hub-card-title">{a.data.title}</h2>
                  {a.data.featured && <span class="hub-badge">Featured</span>}
                </div>
                <p class="hub-card-summary">{a.data.summary}</p>
                <p class="hub-card-meta">
                  Last reviewed{' '}
                  <time datetime={new Date(a.data.last_reviewed).toISOString()}>
                    {new Date(a.data.last_reviewed).toLocaleDateString('en-IN', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hub-page {
    padding: 3rem 1rem 4rem;
    background: var(--color-bg);
  }

  .hub-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .hub-header {
    margin-bottom: 2.5rem;
  }

  .hub-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-warm);
    margin: 0 0 0.5rem;
  }

  .hub-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    line-height: 1.2;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }

  .hub-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 60ch;
    margin: 0;
  }

  .hub-empty {
    background: var(--color-bg-soft);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.25rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .hub-empty p {
    margin: 0;
    max-width: none;
  }

  .hosp-dir-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: white;
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    text-decoration: none;
    color: inherit;
    margin-bottom: 2rem;
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }

  .hosp-dir-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hosp-dir-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hosp-dir-icon svg { width: 26px; height: 26px; }

  .hosp-dir-body { flex: 1; min-width: 0; }

  .hosp-dir-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 0.25rem;
  }

  .hosp-dir-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
    margin: 0 0 0.375rem;
  }

  .hosp-dir-desc {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .hosp-dir-arrow {
    font-size: 1.375rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 540px) {
    .hosp-dir-card { flex-wrap: wrap; }
    .hosp-dir-arrow { display: none; }
  }

  .hub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .hub-item {
    margin: 0;
  }

  .hub-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    transition: border-color var(--transition-fast),
                box-shadow var(--transition-fast),
                transform var(--transition-fast);
  }

  .hub-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .hub-card-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 0.5rem;
  }

  .hub-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
    margin: 0;
  }

  .hub-badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    background: var(--color-accent-soft);
    color: #9a7b14;
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hub-card-summary {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 0.625rem;
    max-width: none;
  }

  .hub-card-meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
    max-width: none;
  }
</style>
