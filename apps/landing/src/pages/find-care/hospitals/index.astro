---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import hospitalsData from '../../../content/hospitals.json';
import { chatUrlFor } from '../../../lib/chat-link';
import { telHref } from '../../../lib/phone.mjs';
import { listable, deptLabel, monthsRecorded } from '../../../lib/hospital-directory.mjs';

type Hospital = (typeof hospitalsData.hospitals)[number];

// Hides incomplete entries and HIDE_UNTIL_CORRECTED (src/lib/hospital-directory.mjs).
const LISTABLE = hospitalsData.hospitals.filter(listable) as Hospital[];

const STATE_ORDER = [
  'Bihar',
  'Jharkhand',
  'West Bengal',
  'Odisha',
  'Northeast',
  'Uttar Pradesh',
  'National',
];

const EAST_INDIA_STATES: Record<string, string> = {
  Bihar: 'Bihar',
  Jharkhand: 'Jharkhand',
  'West Bengal': 'West Bengal',
  Odisha: 'Odisha',
  'Uttar Pradesh': 'Uttar Pradesh',
};
const NORTHEAST_STATES = new Set([
  'Assam', 'Meghalaya', 'Manipur', 'Mizoram',
  'Nagaland', 'Arunachal Pradesh', 'Tripura', 'Sikkim',
]);

function filterGroup(h: Hospital): string {
  if (EAST_INDIA_STATES[h.state]) return EAST_INDIA_STATES[h.state];
  if (NORTHEAST_STATES.has(h.state)) return 'Northeast';
  return 'National';
}

const SORTED = [...LISTABLE].sort((a, b) => {
  const ai = STATE_ORDER.indexOf(filterGroup(a));
  const bi = STATE_ORDER.indexOf(filterGroup(b));
  if (ai !== bi) return ai - bi;
  return a.name.localeCompare(b.name, 'en');
});

const FILTER_COUNTS: Record<string, number> = { All: LISTABLE.length };
STATE_ORDER.forEach((s) => {
  FILTER_COUNTS[s] = LISTABLE.filter((h) => filterGroup(h) === s).length;
});

const FILTERS = [
  { key: 'All', label: 'All' },
  ...STATE_ORDER.map((s) => ({ key: s, label: s })),
].filter((f) => FILTER_COUNTS[f.key] > 0);


// Months in which the listed entries were recorded, from verified_date.
// The field holds the day the research pipeline recorded the entry.
const RECORDED = monthsRecorded(LISTABLE.map((h) => h.verified_date));
---

<BaseLayout
  title="Hospital Directory — Find Cancer Care"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Find Care', path: '/find-care/' },
    { name: 'Hospital Directory', path: '/find-care/hospitals/' },
  ]}
  description={`${LISTABLE.length} entries for hospitals with cancer services recorded in the SCCF directory, in Bihar, Jharkhand, West Bengal, Odisha, Assam and other states.`}
>
  <section class="dir-page">
    <div class="dir-inner">

      <header class="dir-header">
        <p class="dir-eyebrow">Find Care</p>
        <h1>Hospital Directory</h1>
        <p class="dir-intro">
          This page lists {LISTABLE.length} entries for hospitals with cancer services recorded in
          the SCCF directory. They are in Bihar, Jharkhand, Odisha, West Bengal, Assam and other states.
        </p>
      </header>

      <div class="dir-caution">
        <p>
          {RECORDED && <>Entries were recorded {RECORDED}. </>}Details can change. Please confirm
          with the hospital before you travel. Always call ahead to confirm appointments and
          available services. Confirm PMJAY portability directly with the hospital before travelling.
        </p>
        <p>
          <strong>West Bengal note:</strong> WB operates Swasthya Sathi (not central PMJAY) — Bihar
          PMJAY cards are generally not accepted at WB hospitals, whether government or private.
        </p>
      </div>

      <div class="filter-bar" role="group" aria-label="Filter by state">
        {FILTERS.map((f) => (
          <button
            class="filter-pill"
            data-filter={f.key}
            aria-pressed={f.key === 'All' ? 'true' : 'false'}
          >
            {f.label}
            <span class="pill-count">{FILTER_COUNTS[f.key]}</span>
          </button>
        ))}
      </div>

      <ul class="hosp-grid" id="hosp-grid">
        {SORTED.map((h) => (
          <li class="hosp-item" data-state={filterGroup(h)}>
            <div class="hosp-card">

              {(h.ncg_member || h.tmc_affiliated || h.pmjay_empanelled === true) && (
                <div class="card-top">
                  <div class="card-badges">
                    {h.ncg_member && <span class="badge badge-ncg">NCG Member</span>}
                    {h.tmc_affiliated && <span class="badge badge-tmc">TMC</span>}
                    {h.pmjay_empanelled === true && (
                      <span class="badge badge-pmjay">PMJAY</span>
                    )}
                  </div>
                </div>
              )}

              <h2 class="hosp-name">{h.name}</h2>
              <p class="hosp-location">
                {h.city}, {h.state}
                <span class="hosp-type"> · {h.type}</span>
              </p>

              <div class="dept-row">
                {h.departments.slice(0, 4).map((d) => (
                  <span class="dept-tag">{deptLabel(d)}</span>
                ))}
                {h.departments.length > 4 && (
                  <span class="dept-more">+{h.departments.length - 4}</span>
                )}
              </div>

              {h.contact?.phone && (
                <div class="card-foot">
                  {telHref(h.contact.phone)
                    ? <a href={telHref(h.contact.phone)} class="hosp-phone">{h.contact.phone}</a>
                    : <span class="hosp-phone">{h.contact.phone}</span>}
                </div>
              )}

            </div>
          </li>
        ))}
      </ul>

      <aside class="suchi-cta">
        <div class="cta-inner">
          <p class="cta-heading">Not sure which hospital is right for you?</p>
          <p class="cta-body">
            Tell Suchi your location and type of cancer. She can help you think through your
            options and explain what to expect at each step.
          </p>
          <a href={chatUrlFor(Astro.url.pathname)} target="_blank" rel="noopener" class="cta-btn">Ask Suchi →</a>
        </div>
      </aside>


    </div>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const items = document.querySelectorAll<HTMLLIElement>('.hosp-item');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter ?? 'All';
      pills.forEach((p) => p.setAttribute('aria-pressed', 'false'));
      pill.setAttribute('aria-pressed', 'true');
      items.forEach((item) => {
        const match = filter === 'All' || item.dataset.state === filter;
        item.hidden = !match;
      });
    });
  });
</script>

<style>
  .dir-page {
    padding: 3rem 1rem 4rem;
    background: var(--color-bg);
  }

  .dir-inner {
    max-width: 1060px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .dir-header { margin-bottom: 2rem; }

  .dir-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-warm);
    margin: 0 0 0.5rem;
  }

  .dir-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    line-height: 1.2;
    color: var(--color-text-dark);
    margin-bottom: 0.75rem;
  }

  .dir-intro {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 64ch;
    margin: 0;
  }

  /* ── Filter bar ── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: white;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }

  .filter-pill:hover,
  .filter-pill[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-text-dark);
  }

  .pill-count {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    padding: 0.0625rem 0.375rem;
    border-radius: 999px;
  }

  .filter-pill[aria-pressed='true'] .pill-count {
    background: white;
  }

  /* ── Grid ── */
  .hosp-grid {
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .hosp-item { margin: 0; }

  /* ── Card ── */
  .hosp-card {
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.375rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .badge {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge-ncg  { background: #dbeafe; color: #1e40af; }
  .badge-tmc  { background: #f3e8ff; color: #6b21a8; }
  .badge-pmjay { background: #dcfce7; color: #15803d; }

  .hosp-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.3;
    color: var(--color-text-dark);
    margin: 0;
  }

  .hosp-location {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .hosp-type {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* ── Departments ── */
  .dept-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3125rem;
  }

  .dept-tag {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .dept-more {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    color: var(--color-text-muted);
  }

  /* ── Footer ── */
  .card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding-top: 0.625rem;
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .hosp-phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    font-weight: 600;
  }

  a.hosp-phone { color: var(--color-primary); }

  .hosp-phone:hover { text-decoration: underline; }

  /* ── Suchi CTA ── */
  .suchi-cta {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem 1.5rem;
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .cta-heading {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-dark);
    margin: 0 0 0.5rem;
  }

  .cta-body {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
    max-width: 52ch;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-btn {
    display: inline-block;
    padding: 0.625rem 1.5rem;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-md);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
    transition: opacity var(--transition-fast);
  }

  .cta-btn:hover { opacity: 0.88; }

  /* ── Caution note ── */
  .dir-caution {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md, 8px);
    padding: 0.875rem 1rem;
    margin-bottom: 1.5rem;
  }

  .dir-caution p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    max-width: none;
  }

  .dir-caution p:last-child { margin-bottom: 0; }

  /* ── Responsive ── */
  @media (max-width: 760px) {
    .hosp-grid { grid-template-columns: 1fr; }
    .filter-bar { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 0.75rem; }
    .dir-header h1 { font-size: var(--text-4xl, 1.875rem); }
  }
</style>
