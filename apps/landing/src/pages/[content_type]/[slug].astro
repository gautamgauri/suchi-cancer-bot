---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticlePageLayout from '../../layouts/ArticlePageLayout.astro';

// NOTE: treatment/test/side_effect use dedicated nested routes under tests-treatment/.
// Only single-segment content types (no slash in URL) belong here.
export async function getStaticPaths() {
  const CONTENT_TYPE_TO_URL: Record<string, string> = {
    cancer_type: 'cancer-types',
    symptom: 'symptoms',
    journey: 'living-with-cancer',
    find_care: 'find-care',
    meta: 'resources',
    resource: 'resources',
    navigation: 'resources',
  };
  const NESTED_TYPES = new Set(['treatment', 'test', 'side_effect']);
  const articles = await getCollection('articles');
  return articles
    .filter((a) => !NESTED_TYPES.has(a.data.content_type))
    .map((article) => ({
      params: {
        content_type: CONTENT_TYPE_TO_URL[article.data.content_type] ?? 'resources',
        slug: article.data.page_id,
      },
      props: { article },
    }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
---
<ArticlePageLayout article={article} />
