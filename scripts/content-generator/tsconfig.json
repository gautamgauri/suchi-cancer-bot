{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": false,
    "outDir": "./dist",
    "typeRoots": [
      "../../apps/api/node_modules/@types"
    ]
  },
  "include": ["./*.ts"]
}
