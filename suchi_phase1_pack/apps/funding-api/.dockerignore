# Dependencies - installed fresh in Docker
node_modules/

# Build output - built fresh in Docker
dist/

# Test files - not needed in production
**/*.spec.ts
**/*.test.ts
**/__tests__/
coverage/
.nyc_output/

# Local environment
.env
.env.*
!.env.example

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Git
.git/
.gitignore

# Documentation
*.md
!README.md
docs/

# Development scripts (keep prisma migrations)
scripts/
src/scripts/

# Logs and temp
*.log
npm-debug.log*
tmp/
temp/

# TypeScript source maps (optional in prod)
*.map

# Lock files handled by npm ci
yarn.lock
pnpm-lock.yaml
