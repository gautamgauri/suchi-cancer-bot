# Database (Required) — Prisma and the app use DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/funding_db
# If your deploy uses FUNDING_DATABASE_URL, set DATABASE_URL to the same value

# Required for draft/need-statement (OpenAI-compatible API key, e.g. Deepseek)
FUNDING_OPENAI_API_KEY=your-api-key

# Optional LLM
FUNDING_OPENAI_BASE_URL=https://api.deepseek.com/v1
FUNDING_MODEL_DRAFT=deepseek-chat
FUNDING_MODEL_EVAL=
FUNDING_LLM_TIMEOUT_MS=45000

# Google Sheets persistence (optional; when missing, pipeline uses in-memory only)
FUNDING_SHEETS_SPREADSHEET_ID=
FUNDING_GOOGLE_SERVICE_ACCOUNT_JSON=
FUNDING_SHEETS_PIPELINE_TAB=Pipeline
FUNDING_SHEETS_ACTIVITIES_TAB=Activities

# Retrieval engine: pgvector SQL (default) vs legacy JS cosine similarity
# Set to "false" to fall back to legacy in-memory retrieval
USE_PGVECTOR=true

# Server (default 3001 to avoid collision with apps/api)
PORT=3001

# Version endpoint (local: "dev")
GIT_SHA=dev
BUILD_ID=

# Optional: Protect export endpoint
FUNDING_EXPORT_TOKEN=

# Email Notifications (optional; sends generated documents to review recipients)
# SMTP Configuration (required for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Suchi Funding Bot <funding-bot@suchi.org>

# Review recipients (comma-separated; defaults to Diksha Foundation contacts)
FUNDING_REVIEW_RECIPIENTS=contact@dikshafoundation.org,nisha.kumari@dikshafoundation.org

# Delivery guard contracts (internal-only guardrails)
# Comma-separated Slack channel IDs (e.g. C01234567,C07654321), or "*" to allow all internal channels
FUNDING_ALLOWED_SLACK_CHANNEL_IDS=*
# Comma-separated explicit internal email recipients
FUNDING_ALLOWED_EMAIL_RECIPIENTS=
# Comma-separated allowed domains, with or without "@"
FUNDING_ALLOWED_EMAIL_DOMAINS=dikshafoundation.org
# If true, block all delivery targets not in allowlists above
FUNDING_BLOCK_EXTERNAL_DELIVERY=true
# Token accepted for pipeline writes and internal Slack/email (e.g. cron). When set, stalled nudge job can post to Slack.
FUNDING_WRITE_APPROVAL_TOKEN=

# Stalled prospect nudges (BR-PIPE-02): weekday 10:00 AM digest to Slack
# Set to "true" to enable; ensure FUNDING_SLACK_WEBHOOK_URL and FUNDING_WRITE_APPROVAL_TOKEN are set
FUNDING_STALLED_NUDGE_ENABLED=false
# Days without activity to consider a prospect stalled (default 30)
FUNDING_STALLED_PROSPECT_DAYS=30
