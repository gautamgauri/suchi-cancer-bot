{
  "name": "funding-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "kb:ingest-funding": "ts-node src/scripts/ingest-funding-kb.ts --resume",
    "kb:ingest-funding:dry": "ts-node src/scripts/ingest-funding-kb.ts --dryRun",
    "kb:ingest-funding:fresh": "ts-node src/scripts/ingest-funding-kb.ts --wipeChunks --confirmWipe",
    "kb:ingest-funding:no-embeddings": "ts-node src/scripts/ingest-funding-kb.ts --resume --skipEmbeddings",
    "kb:reembed-gemini": "ts-node src/scripts/reembed-with-gemini.ts",
    "kb:reembed-gemini:dry": "ts-node src/scripts/reembed-with-gemini.ts --dry-run",
    "framework:seed": "ts-node src/scripts/seed-framework-taxonomy.ts",
    "framework:seed-mvp": "ts-node src/scripts/seed-mvp-cards.ts",
    "test:smoke": "bash ../../scripts/tester-smoke.sh",
    "test:smoke:quick": "bash ../../scripts/tester-smoke.sh --skip-docker --skip-gcloud"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^5.20.0",
    "cheerio": "^1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "helmet": "^7.1.0",
    "mammoth": "^1.6.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.17",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
