generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PipelineEntry {
  id                  String          @id @default(uuid())
  orgName             String
  contactName         String?
  contactEmail        String?
  stage               String
  owner               String?
  nextAction          String?
  nextActionDate      DateTime?
  lastContactDate     DateTime?
  probability         Int?
  notes               String?
  sectorTags          String[]        @default([])
  geography           String?
  estimatedGrantSize  String?
  deadline            DateTime?       // RFP submission deadline
  submissionEmail    String?         // Funder submission email
  driveFolderUrl      String?         // Link to opportunity folder
  fundingLane         String?        // DOMESTIC_80G | CSR | FCRA
  complianceRiskFlag  String?        // auto-derived
  bankRouteHint       String?        // auto: "Domestic account" | "SBI FCRA account"
  foreignSourceHint   Boolean        @default(false) // true => must use FCRA lane
  // CSR-specific (when fundingLane = CSR)
  csr1Status          String?        // yes | no
  csr1Number          String?
  grantAgreementStatus String?
  reportingCadence    String?        // quarterly | half-yearly
  ucDueDate           DateTime?      // utilisation certificate due
  impactReportDueDate DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  version             Int            @default(1)
  activities          Activity[]
  draftArtifacts      DraftArtifact[]
  opportunity         Opportunity?
  projectCapabilities ProjectCapability[]

  @@index([fundingLane])
  @@index([ucDueDate])
  @@index([impactReportDueDate])
}

model Activity {
  id               String         @id @default(uuid())
  pipelineEntryId  String?
  donorId          String?
  orgId            String?
  type             String
  notes            String?
  timestamp        DateTime       @default(now())
  createdBy        String?
  createdAt        DateTime       @default(now())
  pipelineEntry    PipelineEntry? @relation(fields: [pipelineEntryId], references: [id])
}

model Gift {
  id                String    @id @default(uuid())
  donorName         String
  donorType         String    // individual | org
  amount            Decimal   @db.Decimal(15, 2)
  dateReceived      DateTime
  mode              String    // UPI | NEFT | card | cheque | cash
  txnRef            String?
  mappedBankCredit  Boolean   @default(false) // Y/N
  fundingLane       String    // DOMESTIC_80G | CSR | FCRA
  purposeRestriction String?  @db.Text
  fy                String    // e.g. 2024-25 (derived from dateReceived if not set)
  complianceStatus  String?   // ready_for_10bd | missing_pan | missing_contact | cash_gt_2000_risk (for 10BD gate)
  pan               String?
  contactEmail     String?
  contactMobile    String?
  createdAt         DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dateReceived])
  @@index([fy])
  @@index([fundingLane])
  @@index([mappedBankCredit])
}

model SourceDocument {
  id          String   @id @default(uuid())
  docId       String   @unique
  url         String?
  title       String?
  retrievedAt DateTime @default(now())
  trustTier   String?
  snapshotUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DraftArtifact {
  id               String        @id @default(uuid())
  pipelineEntryId  String
  type             String        // "need_statement" | "email"
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  pipelineEntry    PipelineEntry  @relation(fields: [pipelineEntryId], references: [id], onDelete: Cascade)
  versions         DraftVersion[]
}

model DraftVersion {
  id         String     @id @default(uuid())
  artifactId String
  content    String
  createdBy  String?
  createdAt  DateTime   @default(now())
  artifact   DraftArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  approval   Approval?
}

model Approval {
  id              String       @id @default(uuid())
  versionId      String       @unique
  status         String       // "approved" | "changes_requested"
  decidedBy      String?
  decidedAt      DateTime     @default(now())
  comment        String?
  draftVersion   DraftVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
}

// --- Governance write audit trail (BR-GOV-01 queryable) ---
model GovernanceAuditEntry {
  id         String   @id @default(uuid())
  eventId    String   @unique // idempotency
  eventType  String
  module     String
  action     String
  entityType String
  entityId   String
  actor      Json     // ContractActor
  reason     String?
  timestamp  DateTime
  status     String   // accepted | rejected | noop | failed
  preview    Json?    // WritePreviewContract
  approval   Json?    // ApprovalConfirmationContract
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([status])
  @@index([timestamp])
}

// --- Evidence Library (Phase 1 + 2) ---

model EvidenceDocument {
  id                    String    @id @default(uuid())
  driveFileId           String    @unique
  sourceFolder          String
  orgId                 String?   // tenant isolation: e.g. "diksha", "alok"
  isGlobal              Boolean   @default(false)  // true = shared evidence (WHO, UNICEF, etc.)
  name                  String
  mimeType              String
  size                  BigInt    @default(0)
  createdTime           DateTime
  modifiedTime          DateTime
  parents               Json?
  driveUrl              String?
  owners                String?
  sharedWithDomain      String?   // access control (gotcha 2)
  permissionsSummary   Json?     // access control
  visibilityScope       String?   // internal | restricted | public-safe
  versionKey            String?
  checksum              String?
  needsProcessing       Boolean   @default(true)
  rawStorageUri         String?
  downloadStatus        String?   // pending | success | failed
  downloadError         String?   @db.Text
  downloadedAt          DateTime?
  rawText               String?   @db.Text
  cleanText             String?   @db.Text
  extractionMeta        Json?
  extractionStatus      String?   // success | failed | LOW_TEXT
  needsOcr              Boolean   @default(false)
  canonicalDocId        String?
  docType               String?   // proposal | concept_note | report | budget | presentation | mou | misc
  program               String?   // KHEL | fellowship | life_skills | etc (gotcha 3)
  geography             String?
  docPurpose            String?
  funderName            String?
  qualityScore          Int?
  qualityTier           String?   // A | B | C | X
  corpus                String?   // diksha_internal | theory_frameworks | donor_funder | external_evidence
  flags                 Json?     // array of needs_ocr, low_text, duplicate, etc.
  publicSafe            Boolean   @default(false) // legal/brand (gotcha 9)
  piiDetected           Boolean   @default(false)
  sensitivityLevel      String?   // low | med | high
  cleanTextRedacted     String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  documentChunks        DocumentChunk[]
  reviewQueue           ReviewQueueEntry?
  documentCapabilities  DocumentCapability[]
  documentModalities    DocumentMIModality[]
  @@index([sourceFolder])
  @@index([orgId])
  @@index([needsProcessing])
  @@index([qualityTier])
  @@index([visibilityScope])
  @@index([corpus])
}

model ReviewQueueEntry {
  id                String           @id @default(uuid())
  documentId        String           @unique
  reviewStatus      String           // pending | approved | override | exclude
  tierOverride      String?
  docTypeOverride   String?
  notes             String?
  tags              String[]         @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  document          EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentChunk {
  id             String          @id @default(uuid())
  documentId     String
  chunkIndex     Int
  content        String          @db.Text
  sectionTitle   String?
  tokenCount     Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  document       EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkEmbedding ChunkEmbedding?
}

model ChunkEmbedding {
  id             String       @id @default(uuid())
  chunkId        String       @unique
  embeddingModel String
  vector         String       @db.Text // JSON array of numbers (legacy); kept for backward compat
  embedding      Unsupported("vector(1536)")?  // pgvector native column
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  chunk          DocumentChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

// Run logs for ingestion observability (gotcha 8)
model IngestRun {
  id            String   @id @default(uuid())
  step          String   // inventory | download | extract | score | etc.
  countsIndexed Int?     @default(0)
  countsExtracted Int?   @default(0)
  countsScored  Int?    @default(0)
  errorTypes    Json?   // summary of error types
  durationMs    Int?
  createdAt     DateTime @default(now())
}

// --- Funding Bot: Email-triggered RFP intake ---

model ProcessedEmail {
  id          String   @id @default(uuid())
  messageId   String   @unique  // Gmail message ID for idempotency
  threadId    String?
  processedAt DateTime @default(now())
  opportunityId String?
  createdAt   DateTime @default(now())
  // Foreign key to Opportunity for referential integrity
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  @@index([messageId])
}

model Opportunity {
  id               String    @id @default(uuid())
  opportunityId    String    @unique  // e.g. RF-ESA-2026-27-001
  schemaVersion    String    @default("1.0")
  emailMessageId   String?   @unique
  threadId         String?
  driveFolderId    String?
  driveFolderUrl   String?
  jsonBlob         Json      // full BRD Opportunity JSON
  status           String    @default("received")  // received | extracted | draft_generated | blocked_missing_inputs
  missingInputs   Json?     // array of { field, question, priority }
  pipelineEntryId  String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pipelineEntry    PipelineEntry? @relation(fields: [pipelineEntryId], references: [id])
  auditEvents      OpportunityAuditEvent[]
  proposalRuns     ProposalRun[]
  opportunityCapabilities OpportunityCapability[]
  processedEmails  ProcessedEmail[]
  @@index([status])
  @@index([emailMessageId])
  @@index([opportunityId])
  @@index([createdAt])
  @@index([pipelineEntryId])
}

model ProposalRun {
  id               String   @id @default(uuid())
  opportunityId    String
  status           String   @default("pending") // pending | planning | drafting | qa | complete | failed
  modelConfig      Json     // { planner, writer, reviewer, retriever }
  outline          Json?    // ProposalOutline JSON
  retrievalPlan    Json?    // RetrievalPlan JSON
  complianceReport Json?    // QA results
  artifacts        Json?    // { driveFolderId, docId, evidencePackId }
  gaps             Json?    // Array of missing inputs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  opportunity      Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  sections         ProposalSection[]
  @@index([opportunityId])
  @@index([status])
}

model ProposalSection {
  id               String   @id @default(uuid())
  runId            String
  name             String
  targetWords      Int?
  retrievalQueries Json?    // Array of query strings
  retrievedChunks  Json?    // Array of { chunkId, docId, score }
  draftText        String?  @db.Text
  citations        Json?    // Array of { chunkId, inlineMarker }
  gaps             Json?    // Array of missing evidence descriptions
  status           String   @default("pending") // pending | retrieved | drafted | reviewed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  run              ProposalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
}

model OpportunityAuditEvent {
  id             String     @id @default(uuid())
  opportunityId  String
  action         String     // create_tracker_row | generate_ack_email | generate_outline | populate_annexure | etc.
  status         String     // success | failed | skipped
  details        Json?
  createdAt      DateTime   @default(now())
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  @@index([opportunityId])
}

// --- Framework Integration (Capabilities + MI + Cards) ---

model FrameworkCapability {
  id                   String   @id @default(uuid())
  capabilityId         String   @unique // C1, C2, ..., C10
  name                 String
  definitionShort      String   @db.VarChar(240)
  definitionLong       String   @db.Text
  subdimensions        String[] @default([])
  biharContextExamples String[] @default([])
  measurementIdeas     String[] @default([])
  ethicsRisks          String[] @default([])
  sourceRefs           String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  methodCardCapabilities    MethodCardCapability[]
  patternCardCapabilities   PatternCardCapability[]
  comparableCaseCapabilities ComparableCaseCapability[]
  projectCapabilities       ProjectCapability[]
  opportunityCapabilities   OpportunityCapability[]
  documentCapabilities      DocumentCapability[]
  programActivityCapabilities ProgramActivityCapability[]
  capabilityIndicators      CapabilityIndicator[]
}

model FrameworkMI {
  id                  String   @id @default(uuid())
  miId                String   @unique // MI1, MI2, ..., MI8
  name                String
  definitionShort     String   @db.VarChar(240)
  activitySignals     String[] @default([])
  assessmentArtifacts String[] @default([])
  sourceRefs          String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  methodCardMIs    MethodCardMI[]
  patternCardMIs   PatternCardMI[]
  documentModalities DocumentMIModality[]
}

model FrameworkMethodCard {
  id                  String   @id @default(uuid())
  methodId            String   @unique
  title               String
  intent              String   @db.Text
  steps               String[] @default([])
  whenToUse           String?  @db.Text
  whenNotToUse        String?  @db.Text
  ageBand             String?
  settingTags         String[] @default([])
  assessmentArtifacts  String[] @default([])
  sourceDocId         String?
  sourceUrl           String?
  licenseFlag         String   @default("UNKNOWN") // OK_INTERNAL | NEEDS_REVIEW | UNKNOWN
  qualityScore        Int?     @default(0)
  status              String   @default("draft") // draft | validated | archived
  validatedAt         DateTime?
  validatedBy         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  methodCardMIs         MethodCardMI[]
  methodCardCapabilities MethodCardCapability[]
  chunks                MethodCardChunk[]
}

model MethodCardMI {
  id           String   @id @default(uuid())
  methodCardId String
  miId         String
  isPrimary    Boolean  @default(true)
  methodCard   FrameworkMethodCard @relation(fields: [methodCardId], references: [id], onDelete: Cascade)
  mi           FrameworkMI @relation(fields: [miId], references: [id], onDelete: Cascade)
  @@unique([methodCardId, miId])
}

model MethodCardCapability {
  id           String   @id @default(uuid())
  methodCardId String
  capabilityId String
  methodCard   FrameworkMethodCard @relation(fields: [methodCardId], references: [id], onDelete: Cascade)
  capability   FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([methodCardId, capabilityId])
}

model MethodCardChunk {
  id         String   @id @default(uuid())
  cardId     String
  chunkIndex Int
  content    String   @db.Text
  tokenCount Int?
  card       FrameworkMethodCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  embedding  MethodCardChunkEmbedding?
  @@index([cardId])
}

model MethodCardChunkEmbedding {
  id             String   @id @default(uuid())
  chunkId        String   @unique
  embeddingModel String
  vector         String   @db.Text
  embedding      Unsupported("vector(1536)")?  // pgvector native column
  chunk          MethodCardChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

model FrameworkPatternCard {
  id                  String   @id @default(uuid())
  patternId           String   @unique
  title               String
  durationMins        Int?
  materials           String[] @default([])
  facilitatorScript   String[] @default([])
  adaptations         String[] @default([])
  assessmentArtifacts String[] @default([])
  sourceDocId         String?
  sourceUrl           String?
  evidenceLevel       String   @default("ANECDOTAL") // RESEARCH | PRACTICE_GUIDE | ANECDOTAL
  qualityScore        Int?     @default(0)
  status              String   @default("draft")
  validatedAt         DateTime?
  validatedBy         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  patternCardMIs          PatternCardMI[]
  patternCardCapabilities PatternCardCapability[]
  chunks                  PatternCardChunk[]
}

model PatternCardMI {
  id            String   @id @default(uuid())
  patternCardId String
  miId          String
  isPrimary     Boolean  @default(true)
  patternCard   FrameworkPatternCard @relation(fields: [patternCardId], references: [id], onDelete: Cascade)
  mi            FrameworkMI @relation(fields: [miId], references: [id], onDelete: Cascade)
  @@unique([patternCardId, miId])
}

model PatternCardCapability {
  id            String   @id @default(uuid())
  patternCardId String
  capabilityId  String
  isPrimary     Boolean  @default(true)
  patternCard   FrameworkPatternCard @relation(fields: [patternCardId], references: [id], onDelete: Cascade)
  capability    FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([patternCardId, capabilityId])
}

model PatternCardChunk {
  id         String   @id @default(uuid())
  cardId     String
  chunkIndex Int
  content    String   @db.Text
  tokenCount Int?
  card       FrameworkPatternCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  embedding  PatternCardChunkEmbedding?
  @@index([cardId])
}

model PatternCardChunkEmbedding {
  id             String   @id @default(uuid())
  chunkId        String   @unique
  embeddingModel String
  vector         String   @db.Text
  embedding      Unsupported("vector(1536)")?  // pgvector native column
  chunk          PatternCardChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

model FrameworkComparableCase {
  id                    String   @id @default(uuid())
  caseId                String   @unique
  programName           String
  orgName               String
  geography             String
  targetGroup           String   // children | youth | women | mixed
  deliveryModelTags     String[] @default([])
  outcomesSummary       String   @db.Text
  indicatorsUsed        String[] @default([])
  costNotes             String?  @db.Text
  programConstraints    String?  @db.Text
  contextConstraints    String?  @db.Text
  transferabilityBihar  String?  @db.Text
  sourceDocId           String?
  sourceUrl             String?
  confidenceScore       Int      @default(3) // 1-5
  qualityScore          Int?     @default(0)
  status                String   @default("draft")
  validatedAt           DateTime?
  validatedBy           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  comparableCaseCapabilities ComparableCaseCapability[]
  chunks                     ComparableCaseChunk[]
}

model ComparableCaseCapability {
  id        String   @id @default(uuid())
  caseId    String
  capabilityId String
  isPrimary Boolean  @default(true)
  case      FrameworkComparableCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  capability FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([caseId, capabilityId])
}

model ComparableCaseChunk {
  id         String   @id @default(uuid())
  cardId     String
  chunkIndex Int
  content    String   @db.Text
  tokenCount Int?
  card       FrameworkComparableCase @relation(fields: [cardId], references: [id], onDelete: Cascade)
  embedding  ComparableCaseChunkEmbedding?
  @@index([cardId])
}

model ComparableCaseChunkEmbedding {
  id             String   @id @default(uuid())
  chunkId        String   @unique
  embeddingModel String
  vector         String   @db.Text
  embedding      Unsupported("vector(1536)")?  // pgvector native column
  chunk          ComparableCaseChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
}

// Entity tagging junction tables
model ProjectCapability {
  id              String   @id @default(uuid())
  pipelineEntryId String
  capabilityId    String
  isPrimary       Boolean  @default(false)
  strength        Int?     // 1-5
  isApplicable    Boolean  @default(true)
  pipelineEntry   PipelineEntry @relation(fields: [pipelineEntryId], references: [id], onDelete: Cascade)
  capability      FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([pipelineEntryId, capabilityId])
  @@index([pipelineEntryId])
}

model OpportunityCapability {
  id            String   @id @default(uuid())
  opportunityId String
  capabilityId  String
  isPrimary     Boolean  @default(false)
  strength      Int?
  isApplicable  Boolean  @default(true)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  capability    FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([opportunityId, capabilityId])
  @@index([opportunityId])
}

model DocumentCapability {
  id           String   @id @default(uuid())
  documentId   String
  capabilityId String
  isPrimary    Boolean  @default(false)
  strength     Int?
  document     EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  capability   FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@unique([documentId, capabilityId])
  @@index([documentId])
}

model DocumentMIModality {
  id           String   @id @default(uuid())
  documentId   String
  modalityId   String
  isPrimary    Boolean  @default(false)
  document     EvidenceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  modality     FrameworkMI @relation(fields: [modalityId], references: [id], onDelete: Cascade)
  @@unique([documentId, modalityId])
  @@index([documentId])
}

model FrameworkAnalyticsEvent {
  id         String   @id @default(uuid())
  eventType  String
  userId     String?
  projectId  String?
  metadata   Json     @default("{}")
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([projectId])
  @@index([createdAt])
}

// --- Funder Scraper (TFIx / BDC) ---

model FunderOrg {
  id          String   @id @default(uuid())
  orgName     String
  orgWebsite  String
  network     String   // e.g. TFIx | BDC
  status      String   @default("pending") // pending | in_progress | done | failed
  lastRunAt   DateTime?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  funders     FunderFact[]

  @@index([network])
  @@index([status])
  @@index([createdAt])
}

model FunderFact {
  id               String   @id @default(uuid())
  funderOrgId      String
  orgName          String
  orgWebsite       String
  network          String   // TFIx | BDC
  funderName       String?
  funderType       String   // CSR | Foundation | HNI | Gov | Multilateral | Other
  evidenceType     String
  evidenceExcerpt  String   @db.Text
  evidenceUrl      String
  financialAmount  String?
  grantYears       String?
  programFocus     String?
  geography        String?
  confidenceScore  String   // High | Medium | Low
  notes            String?  @db.Text
  normalizedFunder String?
  matchConfidence  Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org FunderOrg @relation(fields: [funderOrgId], references: [id], onDelete: Cascade)

  @@index([funderOrgId])
  @@index([normalizedFunder])
  @@index([funderType])
  @@index([confidenceScore])
}

// --- Program Activities Registry ---

model ProgramActivity {
  id                String    @id @default(uuid())
  activityId        String    @unique   // e.g. "sports_football", "digital_khan_academy"
  programArea       String               // sports | education | digital | life_skills | civic
  activityName      String               // "Football training"
  description       String    @db.Text
  centers           String[]  @default([])  // ["KHEL Patna", "KHEL Bihta", "KHEL Sarairanjan"]
  targetGroup       String?              // "476 students ages 6-18"
  frequency         String?              // "3x/week"
  assetsNeeded      String[]  @default([])  // ["footballs", "cones", "bibs", "goalposts"]
  unitCostINR       Int?                 // per-unit or per-session cost
  costBreakdown     String?   @db.Text   // "10 footballs x ₹800 = ₹8,000"
  outcomes          String[]  @default([])  // ["attendance improvement", "teamwork skills"]
  indicators        String[]  @default([])  // ["attendance rate", "skill rubric score"]
  evidenceTypes     String[]  @default([])  // ["photos", "attendance logs", "testimonials"]
  staffInvolved     String[]  @default([])  // ["Fellow Teachers", "Sports Coach"]
  orgId             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  instances         ActivityInstance[]
  capabilities      ProgramActivityCapability[]

  @@index([programArea])
  @@index([orgId])
  @@index([isActive])
}

// --- Activity Instances (fortnightly report data) ---

model ActivityInstance {
  id                  String    @id @default(uuid())
  programActivityId   String?   // nullable — unmatched reports can exist
  reportId            String    @unique // e.g. "FR-BI-2026-02A"
  center              String    // "SSS KHEL Bihta"
  program             String    // "KHEL"
  reportingPeriod     String    // "16-31 Jan 2026"
  reportDate          DateTime
  reporter            String?

  // Academic metrics
  academicsNotes      String?   @db.Text
  lifiPhase           String?
  kaActiveStudents    Int?      // Khan Academy active students
  kaHours             Float?
  samagraParticipants Int?

  // SEL metrics
  selSessions         Int?
  selHours            Float?
  selTopic            String?

  // STEAM / enrichment
  steamProjectsCount  Int?
  steamDescription    String?   @db.Text
  baalSansadActivity  String?   @db.Text

  // Community engagement
  openHouseNotes      String?   @db.Text
  eventsDescription   String?   @db.Text
  eventParticipants   Int?
  communityVisits     Int?
  householdsReached   Int?
  childrenReached     Int?
  ptmParentsAttended  Int?

  // Nutrition
  mealsServed         Int?
  avgDailyMeals       Int?

  // Sports & alumni
  sportsActivities    String?   @db.Text
  alumniUpdates       String?   @db.Text

  // Attendance & enrollment
  attendancePercent   Float?
  enrollmentTotal     Int?

  // Operational
  challenges          String?   @db.Text
  notes               String?   @db.Text

  orgId               String?
  gmailMessageId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  programActivity     ProgramActivity? @relation(fields: [programActivityId], references: [id])

  @@index([center])
  @@index([program])
  @@index([reportDate])
  @@index([orgId])
}

// --- ProgramActivity ↔ Capability junction ---

model ProgramActivityCapability {
  id                String    @id @default(uuid())
  programActivityId String
  capabilityId      String
  strength          Int       @default(1)  // 1-3 rating from APF mapping
  isPrimary         Boolean   @default(false)

  programActivity   ProgramActivity    @relation(fields: [programActivityId], references: [id], onDelete: Cascade)
  capability        FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@unique([programActivityId, capabilityId])
}

// --- Capability Indicators (observable signals per capability) ---

model CapabilityIndicator {
  id                String    @id @default(uuid())
  capabilityId      String
  indicatorName     String
  observableSignals String[]  @default([])
  assessmentTools   String[]  @default([])
  monthsActive      String?   // "2-12"
  createdAt         DateTime  @default(now())

  capability        FrameworkCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
}

// --- Program Plans (month-wise structured curriculum) ---

model ProgramPlan {
  id                String    @id @default(uuid())
  planName          String    // "Empowering Futures Adolescent Girls Plan"
  programArea       String    // "adolescent_girls" | "khel" | etc.
  totalMonths       Int       @default(12)
  totalParticipants String?   // "180 girls across 6 slums"
  locations         String[]  @default([])
  orgId             String?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  months            ProgramPlanMonth[]

  @@index([orgId])
  @@index([programArea])
}

model ProgramPlanMonth {
  id                    String    @id @default(uuid())
  planId                String
  monthNumber           Int       // 1-12
  theme                 String    // "Foundation & Mapping"
  primaryCapabilities   String[]  @default([])
  secondaryCapabilities String[]  @default([])
  createdAt             DateTime  @default(now())

  plan                  ProgramPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  weeks                 ProgramPlanWeek[]

  @@unique([planId, monthNumber])
  @@index([planId])
}

model ProgramPlanWeek {
  id                String    @id @default(uuid())
  monthId           String
  weekNumber        Int       // 1-4
  focusArea         String    // "Mapping", "Outreach", etc.
  mainActivities    String    @db.Text
  smartActivities   String    @db.Text
  deliverables      String    @db.Text
  monitoringNotes   String?   @db.Text
  teamNotes         String?   @db.Text
  createdAt         DateTime  @default(now())

  month             ProgramPlanMonth @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([monthId, weekNumber])
  @@index([monthId])
}
