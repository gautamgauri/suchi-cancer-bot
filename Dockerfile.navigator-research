# Dockerfile for Suchi Navigator scheduled jobs
# Runs as a Cloud Run Job triggered by Cloud Scheduler.
#
# Scripts (controlled by NAVIGATOR_SCRIPT env var):
#   daily-researcher.ts  — picks next pending batch, researches via Claude, emails for approval
#   daily-sender.ts      — picks next researched batch, emails for approval (no Claude call)
FROM node:20-alpine

WORKDIR /app

# Copy navigator package files
COPY navigator/package.json navigator/package-lock.json* ./

# Install all dependencies (including @anthropic-ai/sdk)
RUN npm ci 2>/dev/null || npm install

# Copy navigator source
COPY navigator/ ./

ENV NODE_ENV=production
ENV NAVIGATOR_SCRIPT=daily-researcher.ts

CMD sh -c "npx ts-node --transpile-only ${NAVIGATOR_SCRIPT}"
