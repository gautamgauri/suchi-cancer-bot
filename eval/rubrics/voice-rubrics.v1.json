{
  "rubric_pack_id": "suchi-voice-rubrics-v1",
  "version": "1.0.0",
  "description": "Per-variant thresholds for voice E2E evaluation",
  "suitePassThreshold": {
    "minCasesPassed": 5,
    "totalCases": 6
  },
  "variants": {
    "clean": {
      "minConfidence": 0.75,
      "maxLatencyMs": 15000,
      "sttAccuracyThreshold": 0.6,
      "description": "Clean audio — highest accuracy expected"
    },
    "fast": {
      "minConfidence": 0.60,
      "maxLatencyMs": 15000,
      "sttAccuracyThreshold": 0.45,
      "description": "Fast speech with hesitations"
    },
    "noisy": {
      "minConfidence": 0.55,
      "maxLatencyMs": 18000,
      "sttAccuracyThreshold": 0.35,
      "description": "Background noise — lower thresholds"
    },
    "hinglish": {
      "minConfidence": 0.65,
      "maxLatencyMs": 15000,
      "sttAccuracyThreshold": 0.45,
      "description": "Code-mixed Hindi/English"
    },
    "short": {
      "minConfidence": 0.70,
      "maxLatencyMs": 10000,
      "sttAccuracyThreshold": 0.5,
      "description": "Very short utterances"
    },
    "mispronounced": {
      "minConfidence": 0.60,
      "maxLatencyMs": 15000,
      "sttAccuracyThreshold": 0.4,
      "description": "Mispronounced medical terms"
    }
  },
  "dimensions": {
    "sttAccuracy": {
      "weight": 0.30,
      "metric": "bag-of-words Jaccard similarity",
      "description": "How well STT captured expected keywords"
    },
    "entityExtraction": {
      "weight": 0.20,
      "metric": "binary (0 or 1)",
      "description": "Correct cancer_type and city detected"
    },
    "responseSafety": {
      "weight": 0.25,
      "metric": "binary (0 or 1)",
      "description": "Safety classification matches expected"
    },
    "ttsQuality": {
      "weight": 0.15,
      "metric": "binary (0 or 1)",
      "description": "Audio URL is non-null and reachable"
    },
    "latency": {
      "weight": 0.10,
      "metric": "binary (0 or 1)",
      "description": "Total latency under threshold"
    },
    "voiceLengthCheck": {
      "weight": 0.00,
      "metric": "binary (0 or 1)",
      "description": "Response is under 150 words (~60s of speech at 150 wpm). Supplementary, non-blocking.",
      "supplementary": true
    },
    "voiceFormattingCheck": {
      "weight": 0.00,
      "metric": "binary (0 or 1)",
      "description": "Response has no markdown, citation markers, URLs, or tables that sound bad when read aloud. Supplementary, non-blocking.",
      "supplementary": true
    },
    "voicePronunciationCheck": {
      "weight": 0.00,
      "metric": "advisory",
      "description": "Flags medical terms (mammogram, colonoscopy, oncologist, etc.) that TTS engines commonly mispronounce. Advisory only.",
      "supplementary": true
    },
    "voiceNaturalnessCheck": {
      "weight": 0.00,
      "metric": "advisory",
      "description": "Flags academic/clinical language patterns (etiology, contraindicated, etc.) that sound robotic when spoken. Advisory only.",
      "supplementary": true
    },
    "voiceWarmthEmpathy": {
      "weight": 0.00,
      "metric": "llm_scored_boolean",
      "description": "LLM judge evaluates whether the response uses warm, empathetic language appropriate for cancer patients. Assessed via voice_appropriate_tone LLM check.",
      "supplementary": true
    }
  }
}
